# --- Database -----------------------------------------------------------
# Local Postgres started via `docker compose up -d` in this directory.
DATABASE_URL=postgresql+psycopg://adpo:adpo@localhost:5433/adpo

# --- App / session security ---------------------------------------------
# Random 32+ byte secret used to sign session cookies and encrypt stored
# GitHub tokens at rest. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret

# Fernet key used specifically to encrypt GitHub tokens at rest in the DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- GitHub App -----------------------------------------------------------
# Created at https://github.com/settings/apps/new (see backend/README.md
# "GitHub App setup" for the exact permissions/URLs to fill in).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM-encoded App private key. Easiest local option: paste the whole .pem
# file contents here with literal "\n" line breaks kept intact, or set
# GITHUB_APP_PRIVATE_KEY_PATH to a file path instead.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_NAME=adpo-local-dev

# Where GitHub redirects back after a user authorizes the App.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Where to send the browser after login completes.
FRONTEND_SUCCESS_REDIRECT_URL=http://localhost:3000/dashboard
